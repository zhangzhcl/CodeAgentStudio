{
  "name": "codeagent-studio",
  "private": true,
  "version": "0.1.0",
  "description": "CodeAgent开发平台",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @codeagent-studio/desktop build:renderer",
    "verify": "pnpm test && pnpm typecheck && pnpm build"
  }
}
